{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["react"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedIndexedAccess": true,
    "composite": true,
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "files": ["src/local-contract.ts", "src/client/index.ts", "src/client/authority.ts", "src/client/remote-web-api-client.ts", "src/client/locales.ts", "src/client/RemoteSettingsSection.tsx", "src/client/css-modules.d.ts"]
}
